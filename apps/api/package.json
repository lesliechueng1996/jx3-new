{
  "name": "@jx3/api",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "fix": "biome check --write .",
    "test": "bun test --isolate",
    "test:cov": "bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@jx3/db": "workspace:*",
    "better-auth": "^1.6.26",
    "elysia": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "bun-types": "latest"
  },
  "module": "src/index.js"
}